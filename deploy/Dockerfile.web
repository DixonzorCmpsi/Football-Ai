# Production web image: the built frontend served by Caddy, which also terminates TLS,
# applies the login, and proxies /api to the backend.
# Build context: ./Dashboard/predictor-frontend
#   docker build -f deploy/Dockerfile.web -t football-ai-web ./Dashboard/predictor-frontend

FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# tsc -b && vite build -> /app/build. The app calls the API at "/api" (same origin, so
# there is no CORS to configure and no API address baked into the bundle).
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/build /srv
# The Caddyfile is mounted by docker-compose.prod.yml (not baked in), so changing the login
# or the domain is an edit and a restart, not an image rebuild.
