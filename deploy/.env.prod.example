# Copy to /opt/football-ai/.env.prod on the server (deploy.sh does this for you on the first run).
# Never commit the real file.
POSTGRES_PASSWORD=change-me
GCP_PROJECT_ID=football-ai-478621
REGISTRY=us-east1-docker.pkg.dev/football-ai-478621/football-ai
TAG=latest

# IP phase (self-signed certificate, browser warns once):
SITE_ADDRESS=https://203.0.113.10
TLS_MODE=internal
PUBLIC_APP_URL=https://203.0.113.10
# Domain phase:
#   SITE_ADDRESS=your.domain
#   TLS_MODE=you@example.com
#   PUBLIC_APP_URL=https://your.domain

BASIC_AUTH_USER=admin
# Single quotes: the hash contains $ characters. Make one with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the password'
BASIC_AUTH_HASH='$2a$14$replace-me'

RUN_ETL_ON_STARTUP=false
